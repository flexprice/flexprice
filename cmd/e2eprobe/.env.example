# ════════════════════════════════════════════════════════════════
# REQUIRED — fill in
# ════════════════════════════════════════════════════════════════
export E2EPROBE_API_HOST=''
export E2EPROBE_API_KEY=''
export E2EPROBE_TENANT_ID=''
export E2EPROBE_ENVIRONMENT_ID=''

# ════════════════════════════════════════════════════════════════
# GLOBAL toggles
# ════════════════════════════════════════════════════════════════
export E2EPROBE_ENABLED=true                # master kill switch
export E2EPROBE_DRY_RUN=false               # set true to log mutations without executing
export E2EPROBE_EVENT_INGEST_RATE=1         # events/sec for the steady driver
export E2EPROBE_EVENT_INGEST_SEED=42        # deterministic ingest sequence (replayable)
export E2EPROBE_LISTENER_PORT=8765          # HTTP endpoint for the low-wallet webhook
export E2EPROBE_OTEL_ENABLED=false          # enable OTEL span emission
export E2EPROBE_HEARTBEAT_INTERVAL=1h       # heartbeat interval for the heartbeat check
export E2EPROBE_JANITOR_MAX_AGE=1h          # default 1h; raise if you want longer ephemeral lifetimes
export E2EPROBE_LOG_LEVEL=info              # debug|info|warn|error (default info); use debug to see per-tick checkpoints (analytics fetched, drop event ingested, webhook received, aggregation observed, startup grace, ...)

# ════════════════════════════════════════════════════════════════
# PER-CHECK enable + interval (all default to enabled)
# ════════════════════════════════════════════════════════════════
export E2EPROBE_CHECK_SEED_ENSURE_ENABLED=true
export E2EPROBE_CHECK_SEED_ENSURE_INTERVAL=6h

export E2EPROBE_CHECK_EVENT_INGEST_DRIVER_ENABLED=true
# (rate is controlled by E2EPROBE_EVENT_INGEST_RATE; interval ignored)

export E2EPROBE_CHECK_ANALYTICS_PROBE_ENABLED=true
export E2EPROBE_CHECK_ANALYTICS_PROBE_INTERVAL=2m

export E2EPROBE_CHECK_WALLET_BALANCE_PROBE_ENABLED=true
export E2EPROBE_CHECK_WALLET_BALANCE_PROBE_INTERVAL=2m

export E2EPROBE_CHECK_WALLET_DEBIT_VERIFICATION_ENABLED=true
export E2EPROBE_CHECK_WALLET_DEBIT_VERIFICATION_INTERVAL=20m

export E2EPROBE_CHECK_CYCLE_INVOICE_PROBE_ENABLED=true
export E2EPROBE_CHECK_CYCLE_INVOICE_PROBE_INTERVAL=15m

export E2EPROBE_CHECK_ENTITLEMENT_AND_USAGE_PROBE_ENABLED=true

export E2EPROBE_CHECK_CANCEL_CUSTOMER_FLOW_ENABLED=true
export E2EPROBE_CHECK_CANCEL_CUSTOMER_FLOW_INTERVAL=30m

export E2EPROBE_CHECK_SUBSCRIPTION_MODIFICATION_FLOW_ENABLED=true
export E2EPROBE_CHECK_SUBSCRIPTION_MODIFICATION_FLOW_INTERVAL=20m

export E2EPROBE_CHECK_LOW_WALLET_ALERT_LISTENER_ENABLED=true
# (listener is webhook-driven; interval ignored)

# LOW_BALANCE_ALERT_PROBE actively drives the alert-canary wallet across its
# low-balance thresholds and asserts the webhook lands within 2m (grace absorbs
# Kafka + Svix / native HTTP propagation delay). Missing webhooks page Slack
# via the existing reporter chain. Needs the canary wallet provisioned by
# SEED_ENSURE and the Flexprice-side webhook endpoint pointed at
# http://<probe-host>:E2EPROBE_LISTENER_PORT/webhook.
export E2EPROBE_CHECK_LOW_BALANCE_ALERT_PROBE_ENABLED=true
export E2EPROBE_CHECK_LOW_BALANCE_ALERT_PROBE_INTERVAL=5m

export E2EPROBE_CHECK_JANITOR_ENABLED=true
export E2EPROBE_CHECK_JANITOR_INTERVAL=1h

export E2EPROBE_CHECK_METER_AGGREGATION_PROBE_ENABLED=true
export E2EPROBE_CHECK_METER_AGGREGATION_PROBE_INTERVAL=3m

# Billing-coverage probes (2026-08-12 expansion). Each is an ephemeral-customer
# scenario (except bucketed-meter and persistent-billing-invariants which use
# persistent customers) that verifies one billing feature end-to-end against
# the invoice preview. See internal/e2eprobe/AGENTS.md for design and cohort
# ownership.

# Rotates over 3 seed bucketed features (MAX/15MIN, SUM/HOUR, MAX/DAY),
# ingests 3 backdated events per bucket boundary against persistent cust #0,
# asserts per-bucket point count in the GetUsageAnalytics response.
export E2EPROBE_CHECK_BUCKETED_METER_PROBE_ENABLED=true
export E2EPROBE_CHECK_BUCKETED_METER_PROBE_INTERVAL=12m

# Ephemeral sub with $5/mo commitment + 1.5x overage. Alternates under leg
# ($1 usage → true-up expected) and over leg ($7 usage → $8 total expected).
export E2EPROBE_CHECK_COMMITMENT_TRUE_UP_PROBE_ENABLED=true
export E2EPROBE_CHECK_COMMITMENT_TRUE_UP_PROBE_INTERVAL=15m

# Ephemeral sub inheriting plan's soft-limit entitlement (limit=100 on
# e2eprobe_count). Ingests 150 events, asserts usage summary populates.
# Soft-limit deliberately: hard-limit would break the ingest driver.
export E2EPROBE_CHECK_ENTITLEMENT_ENFORCEMENT_PROBE_ENABLED=true
export E2EPROBE_CHECK_ENTITLEMENT_ENFORCEMENT_PROBE_INTERVAL=8m

# Ephemeral sub + shared tax association. Ingests $1 usage, calls preview,
# asserts preview.Taxes contains our rate with correct 10% math. Best-effort
# cleanup of the association at end of run (janitor Phase-3 sweeps orphans).
export E2EPROBE_CHECK_TAX_APPLICATION_PROBE_ENABLED=true
export E2EPROBE_CHECK_TAX_APPLICATION_PROBE_INTERVAL=15m

# Ephemeral sub w/ SubscriptionCoupons at sub-create. Ingests $1 usage,
# calls preview, asserts CouponApplications references SharedCouponID with
# positive discount amount.
export E2EPROBE_CHECK_COUPON_APPLICATION_PROBE_ENABLED=true
export E2EPROBE_CHECK_COUPON_APPLICATION_PROBE_INTERVAL=15m

# Read-only invariant check on cycle invoices for persistent cust #0
# (tax-attached) and cust #1 (coupon-attached). Complements
# cycle-invoice-probe's freshness check with a content check.
export E2EPROBE_CHECK_PERSISTENT_BILLING_INVARIANTS_PROBE_ENABLED=true
export E2EPROBE_CHECK_PERSISTENT_BILLING_INVARIANTS_PROBE_INTERVAL=30m

# Ephemeral sub inheriting the plan-level additive grant entitlement seeded
# on e2eprobe_sum_multiplier_feature (grant_measure=quantity, quota=1000,
# duration=1h, aggregation_mode=additive). Ingests 200 events, verifies
# the sub inherits the grant + usage summary populates. Deep quota-crossing
# assertion + parallel-mode coverage are documented follow-ups. See
# internal/e2eprobe/AGENTS.md section 3 for the reserved-feature layout.
export E2EPROBE_CHECK_ENTITLEMENT_GRANT_ADDITIVE_PROBE_ENABLED=true
export E2EPROBE_CHECK_ENTITLEMENT_GRANT_ADDITIVE_PROBE_INTERVAL=15m

# ════════════════════════════════════════════════════════════════
# SLACK alerts — fill in to enable (leave unset to disable)
# ════════════════════════════════════════════════════════════════
export E2EPROBE_SLACK_WEBHOOK_URL=''
export E2EPROBE_SLACK_CHANNEL=''

# ════════════════════════════════════════════════════════════════
# OTEL export to SigNoz / Grafana Tempo / etc. — fill in to enable
# Honors standard OTLP env vars (no custom prefix). Wires both:
#   - Traces (via internal/e2eprobe/otel.go — SDK reads env vars implicitly)
#   - Structured logs (via cmd/e2eprobe/main.go:buildLoggingConfig — parses
#     the FIRST "name=value" pair from OTEL_EXPORTER_OTLP_HEADERS for auth;
#     enough for common SigNoz / Grafana Cloud / Datadog access-token setups)
# Set E2EPROBE_OTEL_ENABLED=true above to activate the pipeline.
# ════════════════════════════════════════════════════════════════
export OTEL_EXPORTER_OTLP_ENDPOINT=''
export OTEL_EXPORTER_OTLP_HEADERS='' # e.g. 'signoz-access-token=xxx' — first pair used for logs auth
export OTEL_EXPORTER_OTLP_PROTOCOL='' # 'grpc' (default) or 'http'
export OTEL_SERVICE_NAME=''
