# Flexprice backend, UAT.
# Load every key below into Infisical (env slug: flexprice-uat). Jenkins exports them
# to a docker --env-file, so write values WITHOUT quotes and keep JSON on one line.
# FLEXPRICE_DEPLOYMENT_MODE is set per container by deploy.sh; do not set it here.

# --- Identity / logging -------------------------------------------------------
ENVIRONMENT=uat
SERVICE_NAME=flexprice
FLEXPRICE_LOGGING_LEVEL=info
FLEXPRICE_TELEMETRY_DISABLED=true

# --- Secrets (generate fresh: openssl rand -hex 48) --------------------------------
FLEXPRICE_AUTH_PROVIDER=flexprice
FLEXPRICE_AUTH_SECRET=<openssl rand -hex 48>
# Encrypts stored payment-provider credentials. Back it up; changing it later makes them unreadable.
FLEXPRICE_SECRETS_ENCRYPTION_KEY=<openssl rand -hex 48>
# Removes the public dev API key baked into config.yaml.
FLEXPRICE_AUTH_API_KEY_KEYS={}
# The image copies internal/config to /app/config; the default path does not exist there.
FLEXPRICE_RBAC_ROLES_CONFIG_PATH=./config/rbac/roles.json

# --- PostgreSQL (existing server, dedicated database) ---------------------------
FLEXPRICE_POSTGRES_HOST=host.docker.internal
FLEXPRICE_POSTGRES_PORT=5432
FLEXPRICE_POSTGRES_USER=flexprice_uat
FLEXPRICE_POSTGRES_PASSWORD=<password>
FLEXPRICE_POSTGRES_DBNAME=flexprice_uat
FLEXPRICE_POSTGRES_SSLMODE=disable
FLEXPRICE_POSTGRES_MAX_OPEN_CONNS=20
FLEXPRICE_POSTGRES_MAX_IDLE_CONNS=5

# --- Redis (existing server) ----------------------------------------------------
FLEXPRICE_REDIS_HOST=host.docker.internal
FLEXPRICE_REDIS_PORT=5379
FLEXPRICE_REDIS_PASSWORD=<password or empty>
# Pick a DB index no other app uses, and keep the key prefix so keys stay separate.
FLEXPRICE_REDIS_DB=5
FLEXPRICE_REDIS_KEY_PREFIX=flexprice_uat:
# false for a single node; true only for a real Redis Cluster.
FLEXPRICE_REDIS_CLUSTER_MODE=false
FLEXPRICE_REDIS_USE_TLS=false
FLEXPRICE_REDIS_TLS_SKIP_VERIFY=false

# --- ClickHouse (existing server) -----------------------------------------------
# Migrations create tables in a database literally named "flexprice"; keep this value.
FLEXPRICE_CLICKHOUSE_ADDRESS=host.docker.internal:9000
FLEXPRICE_CLICKHOUSE_PROTOCOL=native
FLEXPRICE_CLICKHOUSE_TLS=false
FLEXPRICE_CLICKHOUSE_USERNAME=<user>
FLEXPRICE_CLICKHOUSE_PASSWORD=<password>
FLEXPRICE_CLICKHOUSE_DATABASE=flexprice

# --- Temporal (existing server, own namespace) --------------------------------------
# deploy.sh creates the namespace if it does not exist.
FLEXPRICE_TEMPORAL_ADDRESS=host.docker.internal:7233
FLEXPRICE_TEMPORAL_NAMESPACE=flexprice-uat
FLEXPRICE_TEMPORAL_TLS=false
FLEXPRICE_TEMPORAL_CLIENT_NAME=flexprice-uat
# Retention for closed workflows in the new namespace (used by deploy.sh only).
TEMPORAL_NAMESPACE_RETENTION=168h

# --- Kafka (existing cluster) ------------------------------------------------------
FLEXPRICE_KAFKA_BROKERS=<kafka advertised host>:9094
FLEXPRICE_KAFKA_CLIENT_ID=flexprice-uat
FLEXPRICE_KAFKA_TLS=false
FLEXPRICE_KAFKA_USE_SASL=false
FLEXPRICE_KAFKA_SASL_MECHANISM=
FLEXPRICE_KAFKA_SASL_USER=
FLEXPRICE_KAFKA_SASL_PASSWORD=

# Every Flexprice topic and consumer group is prefixed flexprice_uat_ so nothing
# collides with topics already on the shared cluster.
FLEXPRICE_KAFKA_CONSUMER_GROUP=flexprice_uat_consumer
FLEXPRICE_KAFKA_TOPIC=flexprice_uat_events
FLEXPRICE_KAFKA_TOPIC_LAZY=flexprice_uat_events_lazy
FLEXPRICE_KAFKA_TOPIC_BULK=flexprice_uat_events_bulk
FLEXPRICE_KAFKA_TOPIC_DLQ=flexprice_uat_events_dlq

FLEXPRICE_EVENT_PROCESSING_TOPIC=flexprice_uat_events
FLEXPRICE_EVENT_PROCESSING_CONSUMER_GROUP=flexprice_uat_event_processing
FLEXPRICE_EVENT_PROCESSING_TOPIC_DLQ=flexprice_uat_event_processing_dlq
FLEXPRICE_EVENT_PROCESSING_LAZY_TOPIC=flexprice_uat_events_lazy
FLEXPRICE_EVENT_PROCESSING_LAZY_CONSUMER_GROUP=flexprice_uat_event_processing_lazy
FLEXPRICE_EVENT_PROCESSING_LAZY_TOPIC_DLQ=flexprice_uat_event_processing_lazy_dlq
FLEXPRICE_EVENT_PROCESSING_REPLAY_TOPIC=flexprice_uat_events_backfill
FLEXPRICE_EVENT_PROCESSING_REPLAY_CONSUMER_GROUP=flexprice_uat_event_processing_replay
FLEXPRICE_METER_USAGE_TRACKING_TOPIC=flexprice_uat_events
FLEXPRICE_METER_USAGE_TRACKING_CONSUMER_GROUP=flexprice_uat_meter_usage_tracking
FLEXPRICE_METER_USAGE_TRACKING_TOPIC_DLQ=flexprice_uat_meter_usage_tracking_dlq
FLEXPRICE_METER_USAGE_TRACKING_LAZY_TOPIC=flexprice_uat_events_lazy
FLEXPRICE_METER_USAGE_TRACKING_LAZY_CONSUMER_GROUP=flexprice_uat_meter_usage_tracking_lazy
FLEXPRICE_METER_USAGE_TRACKING_LAZY_TOPIC_DLQ=flexprice_uat_meter_usage_tracking_lazy_dlq
FLEXPRICE_WALLET_BALANCE_ALERT_TOPIC=flexprice_uat_wallet_alert
FLEXPRICE_WALLET_BALANCE_ALERT_CONSUMER_GROUP=flexprice_uat_wallet_alert
FLEXPRICE_WEBHOOK_TOPIC=flexprice_uat_system_events
FLEXPRICE_WEBHOOK_CONSUMER_GROUP=flexprice_uat_system_events
FLEXPRICE_ONBOARDING_EVENTS_TOPIC=flexprice_uat_onboarding_events
FLEXPRICE_ONBOARDING_EVENTS_CONSUMER_GROUP=flexprice_uat_onboarding_events
FLEXPRICE_INTEGRATION_EVENTS_CONSUMER_GROUP=flexprice_uat_integration_events

# Upstream backfill/reprocessing pipelines read Flexprice's own staging/prod topics; off for UAT.
FLEXPRICE_RAW_EVENT_CONSUMPTION_ENABLED=false
FLEXPRICE_RAW_EVENTS_REPROCESSING_ENABLED=false

# Topics `migrate kafka` creates. This REPLACES the topic list in config.yaml.
# Set replicationFactor to your cluster's (1 for a single broker, max 3).
FLEXPRICE_KAFKA_TOPICS={"defaults":{"replicationFactor":1,"retentionMs":604800000},"topics":{"flexprice_uat_events":{"partitions":3},"flexprice_uat_events_lazy":{"partitions":3},"flexprice_uat_events_bulk":{"partitions":1},"flexprice_uat_events_dlq":{"partitions":1},"flexprice_uat_events_backfill":{"partitions":1},"flexprice_uat_event_processing_dlq":{"partitions":1},"flexprice_uat_event_processing_lazy_dlq":{"partitions":1},"flexprice_uat_meter_usage_tracking_dlq":{"partitions":1},"flexprice_uat_meter_usage_tracking_lazy_dlq":{"partitions":1},"flexprice_uat_wallet_alert":{"partitions":1},"flexprice_uat_system_events":{"partitions":1},"flexprice_uat_onboarding_events":{"partitions":1}}}

# --- Public URLs ------------------------------------------------------------------
FLEXPRICE_CUSTOMER_PORTAL_URL=https://<billing-uat-dashboard-domain>/customer-portal
FLEXPRICE_CHECKOUT_BASE_URL=https://<billing-uat-dashboard-domain>
# Empty disables hosted-invoice links; the dashboard has no hosted-invoice page.
FLEXPRICE_HOSTED_INVOICE_BASE_URL=
