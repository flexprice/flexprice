# ════════════════════════════════════════════════════════════════
# REQUIRED
# ════════════════════════════════════════════════════════════════
export E2EPROBE_API_HOST=''            # Flexprice API base URL, including /v1
export E2EPROBE_API_KEY=''             # key for the probe tenant (or use the bootstrap block below)
export E2EPROBE_TENANT_ID=''           # optional, shown in alerts
export E2EPROBE_ENVIRONMENT_ID=''      # optional, shown in alerts

# ════════════════════════════════════════════════════════════════
# SUITE — what runs, on which personas, with which thresholds.
# Everything that used to be E2EPROBE_CHECK_*, E2EPROBE_PAYMENTS_*,
# E2EPROBE_BILLING_MATRIX_*, E2EPROBE_EVENT_INGEST_*, E2EPROBE_HEARTBEAT_INTERVAL
# and E2EPROBE_JANITOR_MAX_AGE lives in the suite file now (see suite.example.yaml).
# Empty runs the suite embedded in the binary.
# ════════════════════════════════════════════════════════════════
export E2EPROBE_SUITE_FILE=''
export E2EPROBE_STATE_FILE=''          # incident snapshot across restarts; default $TMPDIR/e2eprobe-state.json

# ════════════════════════════════════════════════════════════════
# PROCESS
# ════════════════════════════════════════════════════════════════
export E2EPROBE_ENABLED=true           # master kill switch
export E2EPROBE_DRY_RUN=false          # log mutating calls without sending
export E2EPROBE_LOG_LEVEL=info         # debug|info|warn|error
export E2EPROBE_LISTENER_PORT=8765     # inbox (/webhook), /healthz, /status, /inbox/stats
export E2EPROBE_WEBHOOK_TOKEN=''       # optional shared secret; the inbox then requires X-E2EProbe-Token

# ════════════════════════════════════════════════════════════════
# SLACK — leave unset to disable. Bot token wins over the webhook and needs a channel.
# ════════════════════════════════════════════════════════════════
export E2EPROBE_SLACK_WEBHOOK_URL=''
export E2EPROBE_SLACK_BOT_TOKEN=''
export E2EPROBE_SLACK_CHANNEL=''

# ════════════════════════════════════════════════════════════════
# OTEL — standard OTLP env vars; set E2EPROBE_OTEL_ENABLED=true to activate.
# ════════════════════════════════════════════════════════════════
export E2EPROBE_OTEL_ENABLED=false
export OTEL_EXPORTER_OTLP_ENDPOINT=''
export OTEL_EXPORTER_OTLP_HEADERS=''   # e.g. 'signoz-access-token=xxx'; first pair used for logs auth
export OTEL_EXPORTER_OTLP_PROTOCOL=''  # grpc (default) or http
export OTEL_SERVICE_NAME=''

# --- Airgapped bootstrap (optional) -----------------------------------------
# Set these INSTEAD of E2EPROBE_API_KEY. The probe signs up, mints its own key
# and, in Kubernetes, writes it to E2EPROBE_BOOTSTRAP_SECRET_NAME. Requires the
# flexprice-native auth provider.
# E2EPROBE_EMAIL="probe@yourcompany.example"
# E2EPROBE_PASSWORD="use-a-real-secret-here"
# E2EPROBE_BOOTSTRAP_SECRET_NAME="e2eprobe-bootstrap"
# E2EPROBE_BOOTSTRAP_SECRET_KEY="api-key"
